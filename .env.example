# Copier ce fichier en .env puis renseigner les valeurs locales.
DB_DSN=mysql:host=127.0.0.1;dbname=weightaty_db;charset=utf8mb4
DB_USER=weightaty
DB_PASSWORD=
APP_URL=http://localhost:8000
# Dossiers absolus existants, accessibles en écriture et hors du dépôt public.
UPLOAD_DIR=
MAIL_OUTBOX=
# Facultatif si le répertoire PHP par défaut est accessible en écriture.
SESSION_DIR=
PAYMENT_MODE=simulation
# Tarif purement pédagogique : 200 MUR/kg et 50 MUR de frais.
DEMO_RATE_CENTS=20000
DEMO_FEE_CENTS=5000
