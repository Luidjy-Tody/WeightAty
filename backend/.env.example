PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=weightaty
DB_USER=postgres
DB_PASSWORD=

# Clé secrète de signature des jetons JWT (à remplacer par une valeur longue et aléatoire)
JWT_SECRET=changez-moi-par-une-chaine-aleatoire-tres-longue

# Accès démonstration (puces « Expéditeur / Voyageur / Admin » sur l'écran de connexion).
# true = activé, false = désactivé. Si la variable est absente, l'accès démo est
# activé hors production et automatiquement désactivé en production.
DEMO_MODE=false